# Copy to .env.local (untracked). Never commit real values.

# Supabase project URL and ANON key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service-role key: LOCAL SEED SCRIPTS ONLY (added in the schema/seed slice).
# Never prefix with NEXT_PUBLIC_, never import it from app code, never set it on Vercel.
# SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the site, used to build links in auth emails (magic link, confirmation).
# REQUIRED in production (https), and the URL must be on Supabase Auth > URL Configuration > Redirect URLs.
# Without it a production build refuses to send auth emails (it never trusts the request host).
# Omit locally: the request host is used in development only.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app

# Dev-only throwaway account for `npm run test-user -- create` (email MUST end with @amazonclone.test).
# TEST_USER_EMAIL=shopper@amazonclone.test
# TEST_USER_PASSWORD=<generate a random password>
