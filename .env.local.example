# Copy to .env.local (untracked). Never commit real values.

# Supabase project URL and ANON key (safe for the browser; RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service-role key: LOCAL SEED SCRIPTS ONLY (added in the schema/seed slice).
# Never prefix with NEXT_PUBLIC_, never import it from app code, never set it on Vercel.
# SUPABASE_SERVICE_ROLE_KEY=
